# Development setup: works offline without third-party API keys.
APP_ENV=development
DEMO_MODE=true
SECRET_KEY=change-this-to-a-random-64-character-string-before-going-public
ADMIN_EMAIL=owner@example.com
DATABASE_URL=sqlite:///./data/trendmint.db
WEB_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false

# Enable real video generation only after you have reviewed pricing, rights, and provider access.
VIDEO_PROVIDER=demo
FAL_KEY=
FAL_MODEL_ID=fal-ai/kling-video/v2.5-turbo/standard/image-to-video
VIDEO_COST_ESTIMATE_USD=0.50
MAX_DAILY_VIDEO_BUDGET_USD=15.00
LOCAL_VIDEO_RETENTION_DAYS=7

# Public YouTube Data API v3 (search/list and videos/list).
YOUTUBE_API_KEY=
COLLECTION_INTERVAL_HOURS=24

# Stripe one-time packs and monthly subscriptions; webhook is the source of truth.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional hardening for deployment behind reverse proxy
TRUST_PROXY_HEADERS=false
